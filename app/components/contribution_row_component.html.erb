<li class="flex flex-col gap-2 p-3" id="<%= dom_id(@contribution) %>">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="font-medium leading-snug">
        <%= @contribution.name %>
        <% if @contribution.gift? %><span class="badge badge-secondary badge-sm ml-1 align-middle">Gift</span><% end %>
      </p>
      <p class="text-sm opacity-70">
        <% if @contribution.claimed? %>
          <%= mine? ? "You" : @contribution.invitation.guest_name %>
        <% else %>
          <span class="font-medium text-primary">Still needed</span>
        <% end %>
      </p>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <% if @contribution.receipt.attached? %>
        <%= link_to helpers.party_contribution_receipt_path(@event, @contribution), class: "btn btn-ghost btn-sm btn-square", target: "_blank", rel: "noopener", aria: { label: "View receipt for #{@contribution.name}" }, title: "View receipt" do %>🧾<% end %>
      <% end %>
      <% if @contribution.cost_cents > 0 %>
        <span class="font-semibold tabular-nums"><%= helpers.money(@contribution.cost_cents) %></span>
      <% end %>
    </div>
  </div>

  <% if claimable? || editable? %>
    <div class="flex flex-wrap gap-2">
      <% if claimable? %>
        <%= button_to "I'll bring it", helpers.claim_party_contribution_path(@event, @contribution), method: :patch, class: "btn btn-primary btn-sm" %>
      <% end %>
      <% if editable? %>
        <%= link_to needs_cost? ? "Log cost" : "Edit", helpers.edit_party_contribution_path(@event, @contribution), class: "btn btn-sm #{'btn-accent' if needs_cost?}" %>
      <% end %>
    </div>
  <% end %>
</li>
