<% content_for :title, "Your parties" %>

<div class="mb-5 flex items-center justify-between gap-3">
  <h1 class="text-3xl font-semibold">Hi, <%= Current.user.name.split.first %></h1>
  <%= link_to "New party", new_event_path, class: "btn btn-primary" %>
</div>

<% if @upcoming.empty? && @past.empty? %>
  <div class="rounded-box border border-dashed border-base-300 bg-base-100 p-8 text-center">
    <p class="text-4xl">🍽️</p>
    <p class="mt-3 text-lg font-medium">No parties yet</p>
    <p class="mt-1 opacity-70">Set the date, share a link, and let everyone pitch in.</p>
    <%= link_to "Plan your first party", new_event_path, class: "btn btn-primary btn-lg mt-5" %>
  </div>
<% end %>

<% if @upcoming.any? %>
  <h2 class="mb-2 mt-6 text-xl font-semibold">Upcoming</h2>
  <div class="flex flex-col gap-3" id="upcoming_parties">
    <%= render EventCardComponent.with_collection(@upcoming) %>
  </div>
<% end %>

<% if @past.any? %>
  <h2 class="mb-2 mt-8 text-xl font-semibold">Past</h2>
  <div class="flex flex-col gap-3" id="past_parties">
    <%= render EventCardComponent.with_collection(@past) %>
  </div>
<% end %>
