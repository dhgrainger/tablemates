<% content_for :title, @event.title %>
<%# Live updates: the event broadcasts a refresh when anything in the party changes, and Turbo morphs the page in place. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @event %>

<div class="flex flex-col gap-4">
  <%= render "parties/details", event: @event, hosting: hosting? %>
  <%= render "parties/you", event: @event, invitation: current_invitation %>
  <%= render "parties/invite_link", event: @event if hosting? && @event.planning? %>
  <%= render ContributionBoardComponent.new(event: @event, viewer: current_invitation) %>
  <%= render "parties/guests", event: @event, invitations: @invitations %>
</div>
