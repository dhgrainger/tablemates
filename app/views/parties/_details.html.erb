<section class="card border border-base-300 bg-base-100" id="party_details">
  <% if saved_attachment?(event.cover_image) %>
    <figure class="max-h-52"><%= image_tag event.cover_image, alt: "", class: "h-52 w-full object-cover" %></figure>
  <% end %>

  <div class="card-body gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <h1 class="text-3xl font-semibold leading-tight"><%= event.title %></h1>
      <%= render StatusBadgeComponent.new(status: event.status) %>
    </div>

    <dl class="flex flex-col gap-1">
      <div class="flex gap-2"><dt aria-hidden="true">🗓️</dt><dd><span class="sr-only">When: </span><%= event_when(event) %></dd></div>
      <% if event.location.present? %>
        <div class="flex gap-2"><dt aria-hidden="true">📍</dt><dd><span class="sr-only">Where: </span><%= event.location %></dd></div>
      <% end %>
      <div class="flex gap-2"><dt aria-hidden="true">🧑‍🍳</dt><dd>Hosted by <%= event.host.name %></dd></div>
    </dl>

    <% if event.description.present? %>
      <div class="whitespace-pre-line opacity-90"><%= event.description %></div>
    <% end %>

    <% if hosting? %>
      <div class="mt-1 flex flex-wrap gap-2">
        <%= link_to "Edit party", edit_event_path(event), class: "btn btn-sm" %>
      </div>
    <% end %>
  </div>
</section>
