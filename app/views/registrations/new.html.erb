<% content_for :title, "Create your account" %>

<h1 class="mb-1 text-3xl font-semibold">Host a party</h1>
<p class="mb-6 opacity-80">Create a host account. Your guests won't need one.</p>

<%= render FormErrorsComponent.new(record: @user) %>

<%= form_with model: @user, url: registration_path, class: "flex flex-col gap-4" do |form| %>
  <label class="flex flex-col gap-1">
    <span class="font-medium">Your name</span>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", maxlength: 60, class: "input input-lg w-full" %>
  </label>

  <label class="flex flex-col gap-1">
    <span class="font-medium">Email</span>
    <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input input-lg w-full" %>
  </label>

  <label class="flex flex-col gap-1">
    <span class="font-medium">Password</span>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input input-lg w-full" %>
    <span class="text-sm opacity-70">At least 8 characters</span>
  </label>

  <label class="flex flex-col gap-1">
    <span class="font-medium">Venmo username <span class="font-normal opacity-70">(optional)</span></span>
    <%= form.text_field :venmo_username, autocomplete: "off", autocapitalize: "none", placeholder: "@your-venmo", class: "input input-lg w-full" %>
    <span class="text-sm opacity-70">So guests can pay you back after the party</span>
  </label>

  <%= form.submit "Create account", class: "btn btn-primary btn-lg btn-block mt-2" %>
<% end %>

<p class="mt-6 text-center">Already hosting? <%= link_to "Sign in", new_session_path, class: "link link-primary" %></p>
