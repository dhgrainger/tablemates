<%# locals: (form:, reply: true) %>
<% if reply %>
  <fieldset>
    <legend class="mb-1 font-medium">Can you make it?</legend>
    <div class="join w-full">
      <% { "yes" => "I'm in", "maybe" => "Maybe", "no" => "Can't" }.each do |value, label| %>
        <%= form.radio_button :rsvp_status, value, class: "btn join-item grow", aria: { label: label } %>
      <% end %>
    </div>
  </fieldset>
<% end %>

<label class="flex flex-col gap-1">
  <span class="font-medium">Your name</span>
  <%= form.text_field :guest_name, required: true, maxlength: 60, autocomplete: "name", class: "input input-lg w-full" %>
</label>

<label class="flex flex-col gap-1">
  <span class="font-medium">Venmo username <span class="font-normal opacity-70">(optional)</span></span>
  <%= form.text_field :venmo_username, autocomplete: "off", autocapitalize: "none", placeholder: "@your-venmo", class: "input input-lg w-full" %>
  <span class="text-sm opacity-70">Needed if anyone ends up owing you money</span>
</label>

<label class="flex flex-col gap-1">
  <span class="font-medium">Email <span class="font-normal opacity-70">(optional)</span></span>
  <%= form.email_field :email, autocomplete: "email", class: "input input-lg w-full" %>
</label>
