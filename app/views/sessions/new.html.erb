<% content_for :title, "Sign in" %>

<h1 class="mb-6 text-3xl font-semibold">Welcome back</h1>

<%= form_with url: session_path, class: "flex flex-col gap-4" do |form| %>
  <label class="flex flex-col gap-1">
    <span class="font-medium">Email</span>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input input-lg w-full" %>
  </label>

  <label class="flex flex-col gap-1">
    <span class="font-medium">Password</span>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input input-lg w-full" %>
  </label>

  <%= form.submit "Sign in", class: "btn btn-primary btn-lg btn-block mt-2" %>
<% end %>

<div class="mt-6 flex flex-col items-center gap-2">
  <%= link_to "Forgot password?", new_password_path, class: "link" %>
  <p>New here? <%= link_to "Create a host account", new_registration_path, class: "link link-primary" %></p>
</div>
